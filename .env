# NeonClipping settings. This file is part of the repo. Leave secrets blank.
# Values already set in the environment are kept. Blank values use the built-in default.
# Clips, downloads and caches go in ./data inside this folder unless NEONCLIPPING_DATA_DIR is set.

# --- Narrated clips (narrate.py) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
NEONCLIPPING_GEMINI_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Cloud AI for titles, hooks and moment scores (optional) ---
NEONCLIPPING_LLM_BASE_URL=
NEONCLIPPING_LLM_MODEL=
NEONCLIPPING_LLM_KEY=

# --- This computer ---
# 1 forces the small-board profile, 0 forces desktop quality, blank = auto (on for small ARM boards)
NEONCLIPPING_LOW_POWER=
# nvenc | amf | qsv | videotoolbox | v4l2m2m | x264 | auto
NEONCLIPPING_ENCODER=
# 1 = never try a CUDA speech model
NEONCLIPPING_CPU=
# Local faster-whisper model name or folder. Blank = tiny/base on a small board, otherwise the usual model.
FACECAM_ASR_MODEL=

# --- Paths (blank = inside this folder) ---
# Download and clip storage. Default: ./data
NEONCLIPPING_DATA_DIR=
# Narrated MP4s. Default: ./data/narrate-out
NEONCLIPPING_NARRATE_OUT=

# --- Server ---
# Default 8770
NEONCLIPPING_PORT=
# 1 = phone remote on the home network (PIN required). Default off.
NEONCLIPPING_LAN=

# --- Live / long videos ---
# Unattended creator watch, hours. Default 3.
NEONCLIPPING_LIVE_AUTO_HOURS=
# Stop an unattended recording below this many free GB. Default 8.
NEONCLIPPING_MIN_FREE_GB=
# Sources longer than this many seconds ask for a part. Default 7200.
NEONCLIPPING_LONG_SECONDS=

# --- YouTube login (optional; leave blank) ---
# chrome | edge | firefox | brave | opera | vivaldi
NEONCLIPPING_COOKIES_BROWSER=
NEONCLIPPING_COOKIES_FILE=

# --- Optional links (https only) ---
NEONCLIPPING_DONATE_RAZORPAY=
NEONCLIPPING_DONATE_PAYPAL=
NEONCLIPPING_REPORT_URL=
